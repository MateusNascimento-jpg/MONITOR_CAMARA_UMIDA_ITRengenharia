# Copie para .env apenas em testes locais — no Coolify, cadastre em "Environment Variables"
PORT=3000
DATABASE_URL=postgres://usuario:senha@host:5432/banco
# Chave que o ESP32 envia no header x-api-key (gere com: openssl rand -hex 32)
API_KEY=troque-por-uma-chave-longa
# Token para alterar limites pelo painel (header x-admin-token)
ADMIN_TOKEN=troque-por-outro-token-longo
